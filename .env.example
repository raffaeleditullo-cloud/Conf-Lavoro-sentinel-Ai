# ══════════════════════════════════════════════════════════════════════════════
# CONF-LAVORO SENTINEL AI - FASE 1: MOTORE PERCETTIVO (FRIGATE NVR)
# FILE MODELLO DELLE VARIABILI D'AMBIENTE (.env.example)
#
# ISTRUZIONI PER ALESSIO:
# 1. Copiare questo file in .env (`cp .env.example .env`)
# 2. Compilare tutti i campi contrassegnati con DA_COMPILARE_*
# 3. NON committare mai il file .env su repository
#
# NOTA SUI PARAMETRI NON PRESENTI IN QUESTO FILE:
# - I giorni di conservazione video e l'accelerazione decodifica hardware (ffmpeg)
#   NON supportano variabili d'ambiente in Frigate e sono configurati nel
#   "BLOCCO PARAMETRI SPECIFICI DEL SITO" all'inizio di config/config.yml.
# - Lo schema degli indirizzi IP (VLAN 20) è documentato in docs/MANUALE_ALESSIO.md.
# ══════════════════════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────────────────────
# 1. VERSIONE FRIGATE E RUNTIME PIATTAFORMA (Letti da docker-compose.yml)
# ──────────────────────────────────────────────────────────────────────────────
# Versione bloccata di Frigate
FRIGATE_VERSION=0.17.2

# Suffisso immagine Docker:
# - Su PC di sviluppo (x86_64 / amd64): lasciare vuoto
# - Su Jetson Orin Nano (arm64, JetPack 6): impostare a -tensorrt-jp6
FRIGATE_IMAGE_SUFFIX=

# Runtime Docker:
# - Su PC di sviluppo (x86_64 standard): runc
# - Su Jetson Orin Nano (JetPack 6 con NVIDIA Container Toolkit): nvidia
DOCKER_RUNTIME=runc

# Fuso orario di sistema
TZ=Europe/Rome

# ──────────────────────────────────────────────────────────────────────────────
# 2. PERCORSI DI ARCHIVIAZIONE (Letti da docker-compose.yml)
# ──────────────────────────────────────────────────────────────────────────────
# Punti di montaggio sull'host:
# - Su PC di sviluppo: cartelle relative (./storage/...)
# - Su Jetson Orin Nano: impostare i mount dell'SSD NVMe
#   Esempio Jetson:
#   STORAGE_RECORDINGS_PATH=/mnt/storage/recordings
#   STORAGE_DB_PATH=/mnt/storage/db
STORAGE_RECORDINGS_PATH=./storage/recordings
STORAGE_DB_PATH=./storage/db

# ──────────────────────────────────────────────────────────────────────────────
# 3. CREDENZIALI BROKER MQTT (Letti da Frigate in config/config.yml)
# ──────────────────────────────────────────────────────────────────────────────
# NOTA: L'utente e password qui indicati devono coincidere con quelli generati
# nel file delle password di Mosquitto (Passo 1 del manuale).
FRIGATE_MQTT_HOST=mosquitto
FRIGATE_MQTT_USER=DA_COMPILARE_UTENTE_MQTT
FRIGATE_MQTT_PASSWORD=DA_COMPILARE_PASSWORD_MQTT

# ──────────────────────────────────────────────────────────────────────────────
# 4. URL DEI FLUSSI RTSP TELECAMERE REOLINK (Letti da Frigate in config/config.yml)
# ──────────────────────────────────────────────────────────────────────────────
# ATTENZIONE: Leggere l'URL esatto dall'interfaccia web di ciascuna telecamera.
# Main: flusso 4K per la registrazione
# Sub:  flusso a bassa risoluzione per il rilevamento IA
FRIGATE_CAM_VARCO_CARRABILE_MAIN_URL=rtsp://DA_COMPILARE_USER:DA_COMPILARE_PASSWORD@192.168.20.11:554/h264Preview_01_main
FRIGATE_CAM_VARCO_CARRABILE_SUB_URL=rtsp://DA_COMPILARE_USER:DA_COMPILARE_PASSWORD@192.168.20.11:554/h264Preview_01_sub

FRIGATE_CAM_VARCO_PEDONALE_MAIN_URL=rtsp://DA_COMPILARE_USER:DA_COMPILARE_PASSWORD@192.168.20.12:554/h264Preview_01_main
FRIGATE_CAM_VARCO_PEDONALE_SUB_URL=rtsp://DA_COMPILARE_USER:DA_COMPILARE_PASSWORD@192.168.20.12:554/h264Preview_01_sub

FRIGATE_CAM_PIAZZALE_MAIN_URL=rtsp://DA_COMPILARE_USER:DA_COMPILARE_PASSWORD@192.168.20.13:554/h264Preview_01_main
FRIGATE_CAM_PIAZZALE_SUB_URL=rtsp://DA_COMPILARE_USER:DA_COMPILARE_PASSWORD@192.168.20.13:554/h264Preview_01_sub
