# ══════════════════════════════════════════════════════════════════════════════
# CONF-LAVORO SENTINEL AI - FASE 2: ORCHESTRATORE ATTIVO
# FILE MODELLO DELLE VARIABILI D'AMBIENTE (.env.example)
# ══════════════════════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────────────────────
# 1. VERSIONE FRIGATE E RUNTIME PIATTAFORMA
# ──────────────────────────────────────────────────────────────────────────────
FRIGATE_VERSION=0.17.2
FRIGATE_IMAGE_SUFFIX=
DOCKER_RUNTIME=runc
TZ=Europe/Rome

# ──────────────────────────────────────────────────────────────────────────────
# 2. PERCORSI DI ARCHIVIAZIONE
# ──────────────────────────────────────────────────────────────────────────────
STORAGE_RECORDINGS_PATH=./storage/recordings
STORAGE_DB_PATH=./storage/db
STORAGE_CLIPS_PATH=./storage/clips

# ──────────────────────────────────────────────────────────────────────────────
# 3. CREDENZIALI BROKER MQTT
# ──────────────────────────────────────────────────────────────────────────────
FRIGATE_MQTT_HOST=mosquitto
FRIGATE_MQTT_USER=sentinel
FRIGATE_MQTT_PASSWORD=DA_COMPILARE_PASSWORD_MQTT

# ──────────────────────────────────────────────────────────────────────────────
# 4. URL DEI FLUSSI STREAMING TELECAMERE REOLINK
# Mappatura fisica ambiente di test / produzione (certificata da Alessio):
# - PIAZZALE  (192.168.1.22): Piazzale esterno, entrata magazzino, auto e parcheggio
# - MAGAZZINO (192.168.1.20): Interno capannone, stoccaggio merci, scaffali e bancali
# - CORRIDOIO (192.168.1.21): Corridoio stretto di collegamento tra magazzino e azienda
# ──────────────────────────────────────────────────────────────────────────────
# Flussi Low-Latency HTTP-FLV Reolink (Porta RTMP 1935 abilitata da telecamera, zero buffer):
FRIGATE_CAM_PIAZZALE_MAIN_URL=ffmpeg:http://192.168.1.22/flv?port=1935&app=bcs&stream=channel0_main.bcs&user=admin&password=DA_COMPILARE_PASSWORD#video=copy#audio=copy
FRIGATE_CAM_PIAZZALE_SUB_URL=ffmpeg:http://192.168.1.22/flv?port=1935&app=bcs&stream=channel0_sub.bcs&user=admin&password=DA_COMPILARE_PASSWORD

FRIGATE_CAM_MAGAZZINO_MAIN_URL=ffmpeg:http://192.168.1.20/flv?port=1935&app=bcs&stream=channel0_main.bcs&user=admin&password=DA_COMPILARE_PASSWORD#video=copy#audio=copy
FRIGATE_CAM_MAGAZZINO_SUB_URL=ffmpeg:http://192.168.1.20/flv?port=1935&app=bcs&stream=channel0_sub.bcs&user=admin&password=DA_COMPILARE_PASSWORD

FRIGATE_CAM_CORRIDOIO_MAIN_URL=ffmpeg:http://192.168.1.21/flv?port=1935&app=bcs&stream=channel0_main.bcs&user=admin&password=DA_COMPILARE_PASSWORD#video=copy#audio=copy
FRIGATE_CAM_CORRIDOIO_SUB_URL=ffmpeg:http://192.168.1.21/flv?port=1935&app=bcs&stream=channel0_sub.bcs&user=admin&password=DA_COMPILARE_PASSWORD

# ──────────────────────────────────────────────────────────────────────────────
# 5. DISPOSITIVI DI CAMPO E ATTUATORI (FASE 2)
# ──────────────────────────────────────────────────────────────────────────────
# Scheda Relè Waveshare Modbus TCP
RELAY_HOST=192.168.1.30
RELAY_PORT=4196
# Gestione Illuminazione Dissuasione
# USE_REOLINK_SPOTLIGHT=true: usa i fari LED bianchi integrati nelle telecamere Reolink (consigliato, zero relè)
# USE_EXTERNAL_RELAY_LIGHT=false: disabilita l'accensione del faretto esterno su relè Waveshare
USE_REOLINK_SPOTLIGHT=true
USE_EXTERNAL_RELAY_LIGHT=false

# Mappatura canali relè (1-based, canale 2 riservato al cancello):
RELAY_CHANNEL_PIAZZALE=1
RELAY_CHANNEL_MAGAZZINO=1
RELAY_CHANNEL_CORRIDOIO=1
RELAY_CHANNEL_CANCELLO=2

# Altoparlante IP Fanvil A233
# NOTA: la riproduzione avviene in MULTICAST RTP tramite ffmpeg, non via HTTP.
# SPEAKER_HOST/PORT/USER/PASSWORD restano solo per diagnostica e accesso al dispositivo.
SPEAKER_HOST=192.168.1.31
SPEAKER_PORT=80
SPEAKER_USER=admin
SPEAKER_PASSWORD=admin

# Canale multicast su cui l'A233 e' gia' in ascolto (collaudato in campo da Alessio).
# Sullo speaker vanno disattivati "Multicast Tone" e "Auto HangUp Tone" per evitare i 3 bip finali.
FANVIL_MULTICAST_IP=239.255.1.1
FANVIL_MULTICAST_PORT=5004
# Volume di ripiego 0-100 quando config/system_settings.json non e' leggibile
FANVIL_DEFAULT_VOLUME=70
# Pre-roll in millisecondi: silenzio trasmesso dall'AudioBus all'inizio di ogni sequenza parlata
# per dare tempo all'amplificatore del Fanvil A233 di aprirsi senza tagliare la prima parola.
FANVIL_RTP_DELAY_MS=150
# Silenzio trasmesso DOPO l'ultimo annuncio per tenere aperto il canale (0 = disattivo).
# Con un valore come 4000 la frase di ORIN che segue il Riflesso non richiede un nuovo pre-roll.
# Da collaudare in campo prima di attivarlo.
FANVIL_RTP_HOLD_MS=0
# IP della Jetson sulla LAN dello speaker: forza l'interfaccia d'uscita del multicast
# (con network_mode: host esiste anche docker0). Vuoto = instradamento di sistema.
FANVIL_MULTICAST_IFACE_IP=
# TTL dei pacchetti multicast (16 = valore storico di ffmpeg)
FANVIL_MULTICAST_TTL=16

# NAS Ugreen per archiviazione remota degli eventi
NAS_IP=192.168.1.11
NAS_SHARE=sentinel-eventi
NAS_USER=jetson
NAS_PASSWORD=Confprov33

# ──────────────────────────────────────────────────────────────────────────────
# 6. CONFIGURAZIONE LOGICA DI ALLARME E VOCE (SENTINEL AI)
# ──────────────────────────────────────────────────────────────────────────────
# Pacchetto vocale attivo: 'carmelo' (maschile autorevole) oppure 'sami' (femminile chiara)
SENTINEL_VOICE_PACK=carmelo

# Durata accensione faretto su rilevamento (in secondi)
FARETTO_DURATION_SECONDS=30

# Cooldown locale per singola telecamera/zona (in secondi)
AUDIO_COOLDOWN_SECONDS=15

# Cooldown GLOBALE altoparlante (in secondi):
# Impedisce che il passaggio dello stesso intruso sotto 3 telecamere consecutive
# faccia urlare 3 allarmi sovrapposti nei primi metri, ma riattiva la voce già dopo
# 20 secondi se l'intruso non se ne va o se sopraggiunge un secondo complice.
SPEAKER_GLOBAL_COOLDOWN_SECONDS=20

# Livello 0 — Riflesso immediato (frasi brevi gia' in RAM, diffuse al primo rilevamento).
# I due cooldown qui sopra valgono per il Riflesso; la frase di ORIN che lo segue
# entro REFLEX_THOUGHT_WINDOW_SECONDS ha sempre la parola, una sola volta.
# Libreria: python scripts/generate_reflex_library.py (senza libreria usa le tracce 03/04).
REFLEX_ENABLED=true
REFLEX_THOUGHT_WINDOW_SECONDS=30
# Entro questo intervallo un nuovo riflesso sulla stessa telecamera usa le frasi di recidiva
REFLEX_ESCALATION_SECONDS=120
# Fascia notturna per la scelta delle frasi (formato HH:MM)
REFLEX_NIGHT_START=19:00
REFLEX_NIGHT_END=07:00

# Filtro Proporzioni Sagome Umane (Disattivato per massima reattività immediata senza ritardi):
# Se true, filtra sagome con H/W inferiore alla soglia. Mantenere a false per evitare latenze di conferma.
HUMAN_RATIO_FILTER_ENABLED=false
MIN_HUMAN_ASPECT_RATIO=0.20
MAX_PERSON_AREA_RATIO=0.95

# Filtro Movimento Dinamico & Traiettoria (Pezzettino 2 - Anti-Static & Early Threat):
# Sopprime gli allarmi se la sagoma rimane ferma o compie micro-spostamenti inferiori
# al 2.5% dello schermo (evita trigger ripetuti su oggetti statici o figure chinate ferme).
MOVEMENT_FILTER_ENABLED=true
MIN_MOVEMENT_DISTANCE=0.025

# ──────────────────────────────────────────────────────────────────────────────
# 7. DASHBOARD WEB HUB (FASE 3) — FACOLTATIVE
# Tutte hanno un valore predefinito corretto per l'esecuzione in Docker:
# vanno compilate solo per sovrascrivere i percorsi o gli host rilevati in automatico.
# ──────────────────────────────────────────────────────────────────────────────
# Porta di ascolto dell'interfaccia commerciale
# DASHBOARD_PORT=8080

# Host e porta dell'API interna di Frigate, usate dal proxy di snapshot, clip e
# fotogrammi telecamera. In Docker il nome del servizio e' gia' corretto.
# FRIGATE_HOST=frigate
# FRIGATE_PORT=5000

# Cartella del database SQLite di Frigate, montata in sola lettura dal compose.
# Se questa cartella non e' raggiungibile l'Archivio Evidenze resta vuoto.
# DB_DIR=/media/frigate/db
# DB_PATH=/media/frigate/db/frigate.db

# Cartella dei pacchetti audio ufficiali (carmelo / sami), montata da ./orchestrator/audio
# AUDIO_DIR=/app/audio

# ──────────────────────────────────────────────────────────────────────────────
# 8. ORIN CYBERNETIC BRAIN // MULTIMODAL AI & STREAMING TTS
# ──────────────────────────────────────────────────────────────────────────────
# Chiave API OpenRouter (per modello vision Gemini 2.5 Flash):
OPENROUTER_API_KEY=sk-or-v1-DA_COMPILARE_CHIAVE_OPENROUTER
ORIN_VISION_MODEL=google/gemini-2.5-flash
ORIN_TIMEOUT_SECONDS=3.5

# Chiave API ElevenLabs (per sintesi vocale dinamica ultra-realistica streaming Turbo v2.5):
ELEVENLABS_API_KEY=DA_COMPILARE_CHIAVE_ELEVENLABS

# ──────────────────────────────────────────────────────────────────────────────
# 9. GOOGLE GEMINI MULTIMODAL LIVE API (INTERAZIONE BIDIREZIONALE / JARVIS)
# ──────────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=AIzaSy_DA_COMPILARE_CHIAVE_GOOGLE_AI_STUDIO
GEMINI_LIVE_MODEL=gemini-2.0-flash-exp
GEMINI_LIVE_VOICE=Charon

