# ══════════════════════════════════════════════════════════════════════════════
# CONF-LAVORO SENTINEL AI - FASE 2: ORCHESTRATORE ATTIVO
# FILE MODELLO DELLE VARIABILI D'AMBIENTE (.env.example)
# ══════════════════════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────────────────────
# 1. VERSIONE FRIGATE E RUNTIME PIATTAFORMA
# ──────────────────────────────────────────────────────────────────────────────
FRIGATE_VERSION=0.17.2
FRIGATE_IMAGE_SUFFIX=
DOCKER_RUNTIME=runc
TZ=Europe/Rome

# ──────────────────────────────────────────────────────────────────────────────
# 2. PERCORSI DI ARCHIVIAZIONE
# ──────────────────────────────────────────────────────────────────────────────
STORAGE_RECORDINGS_PATH=./storage/recordings
STORAGE_DB_PATH=./storage/db

# ──────────────────────────────────────────────────────────────────────────────
# 3. CREDENZIALI BROKER MQTT
# ──────────────────────────────────────────────────────────────────────────────
FRIGATE_MQTT_HOST=mosquitto
FRIGATE_MQTT_USER=sentinel
FRIGATE_MQTT_PASSWORD=DA_COMPILARE_PASSWORD_MQTT

# ──────────────────────────────────────────────────────────────────────────────
# 4. URL DEI FLUSSI RTSP TELECAMERE REOLINK
# ──────────────────────────────────────────────────────────────────────────────
FRIGATE_CAM_VARCO_CARRABILE_MAIN_URL=rtsp://admin:DA_COMPILARE_PASSWORD@192.168.1.20:554/h264Preview_01_main
FRIGATE_CAM_VARCO_CARRABILE_SUB_URL=rtsp://admin:DA_COMPILARE_PASSWORD@192.168.1.20:554/h264Preview_01_sub

FRIGATE_CAM_VARCO_PEDONALE_MAIN_URL=rtsp://admin:DA_COMPILARE_PASSWORD@192.168.1.21:554/h264Preview_01_main
FRIGATE_CAM_VARCO_PEDONALE_SUB_URL=rtsp://admin:DA_COMPILARE_PASSWORD@192.168.1.21:554/h264Preview_01_sub

FRIGATE_CAM_PIAZZALE_MAIN_URL=rtsp://admin:DA_COMPILARE_PASSWORD@192.168.1.22:554/h264Preview_01_main
FRIGATE_CAM_PIAZZALE_SUB_URL=rtsp://admin:DA_COMPILARE_PASSWORD@192.168.1.22:554/h264Preview_01_sub

# ──────────────────────────────────────────────────────────────────────────────
# 5. DISPOSITIVI DI CAMPO E ATTUATORI (FASE 2)
# ──────────────────────────────────────────────────────────────────────────────
# Scheda Relè Waveshare Modbus TCP
RELAY_HOST=192.168.1.30
RELAY_PORT=4196
# Mappatura canali relè (1-based): sul banco tutti i fari puntano al Canale 1
RELAY_CHANNEL_PIAZZALE=1
RELAY_CHANNEL_VARCO_PEDONALE=1
RELAY_CHANNEL_VARCO_CARRABILE=1
RELAY_CHANNEL_CANCELLO=2

# Altoparlante IP Fanvil A233
SPEAKER_HOST=192.168.1.31
SPEAKER_PORT=80
SPEAKER_USER=admin
SPEAKER_PASSWORD=admin

# NAS Ugreen per archiviazione remota degli eventi
NAS_IP=192.168.1.11
NAS_SHARE=sentinel-eventi
NAS_USER=jetson
NAS_PASSWORD=Confprov33

# ──────────────────────────────────────────────────────────────────────────────
# 6. CONFIGURAZIONE LOGICA DI ALLARME E VOCE (SENTINEL AI)
# ──────────────────────────────────────────────────────────────────────────────
# Pacchetto vocale attivo: 'carmelo' (maschile autorevole) oppure 'sami' (femminile chiara)
SENTINEL_VOICE_PACK=carmelo

# Durata accensione faretto su rilevamento (in secondi)
FARETTO_DURATION_SECONDS=30

# Cooldown tra annunci vocali consecutivi (in secondi) per evitare ripetizioni a raffica
AUDIO_COOLDOWN_SECONDS=15

# ──────────────────────────────────────────────────────────────────────────────
# 7. DASHBOARD WEB HUB (FASE 3) — FACOLTATIVE
# Tutte hanno un valore predefinito corretto per l'esecuzione in Docker:
# vanno compilate solo per sovrascrivere i percorsi o gli host rilevati in automatico.
# ──────────────────────────────────────────────────────────────────────────────
# Porta di ascolto dell'interfaccia commerciale
# DASHBOARD_PORT=8080

# Host e porta dell'API interna di Frigate, usate dal proxy di snapshot, clip e
# fotogrammi telecamera. In Docker il nome del servizio e' gia' corretto.
# FRIGATE_HOST=frigate
# FRIGATE_PORT=5000

# Cartella del database SQLite di Frigate, montata in sola lettura dal compose.
# Se questa cartella non e' raggiungibile l'Archivio Evidenze resta vuoto.
# DB_DIR=/media/frigate/db
# DB_PATH=/media/frigate/db/frigate.db

# Cartella dei pacchetti audio ufficiali (carmelo / sami), montata da ./orchestrator/audio
# AUDIO_DIR=/app/audio
