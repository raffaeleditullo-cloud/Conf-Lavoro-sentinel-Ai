# File di ambiente con credenziali reali e backup
.env
.env.*
*.bak

# Dati persistenti di registrazione e database
storage/recordings/
storage/db/
storage/logs/



# Cache modelli generati localmente a runtime (es. TensorRT engine compilati sul Jetson)
config/model_cache/*
!config/model_cache/.gitkeep


# File temporanei di sistema
*.log
.DS_Store
Thumbs.db
__pycache__/
*.py[cod]
serve.js

# File password Mosquitto generato localmente da mosquitto_passwd
mosquitto/config/pwfile

# File di runtime configurazione e stato (modificati sul Jetson)
config/system_settings.json
config/detector_status.json

